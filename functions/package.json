{
  "name": "faangin-billing-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase Cloud Functions v2 backend for Faangin billing & entitlement service.",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "sync-types": "node ../scripts/sync-shared-types.mjs",
    "prebuild": "npm run sync-types",
    "pretypecheck": "npm run sync-types",
    "pretest": "npm run sync-types",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "firebase-admin": "12.6.0",
    "firebase-functions": "6.1.1",
    "stripe": "17.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "firebase-functions-test": "3.4.0",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
