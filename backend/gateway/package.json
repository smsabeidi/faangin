{
  "name": "faangin-gateway",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "node --import tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
