rules_version = '2';

// Faangin billing & entitlement collections are SERVER-ONLY.
// Every read/write goes through Cloud Functions using the Admin SDK;
// no client (web or app) is permitted direct Firestore access.
service cloud.firestore {
  match /databases/{database}/documents {

    // Explicit server-only billing collections. Every path below is
    // blocked for every authenticated and unauthenticated caller.
    match /entitlements/{uid} {
      allow read, write: if false;
    }
    match /deviceCodes/{deviceCode} {
      allow read, write: if false;
    }
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }
    match /revokedJtis/{jti} {
      allow read, write: if false;
    }

    // Default deny for anything not matched above. Keep this last so a
    // forgotten collection cannot leak through.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
